# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Alternatively, export as TF_VAR_* env vars.

# vercel_api_token  = "vrcl_xxx"                  # required (or use TF_VAR_vercel_api_token)
# vercel_team_id    = ""                          # optional, blank = personal account
# project_name      = "simple-todos"
# github_repo       = "your-gh-user/simple-todos" # optional, blank = no Git wiring
# production_branch = "main"
# custom_domain     = ""                          # optional, e.g. "todos.example.com"
# anthropic_api_key = "sk-ant-..."                # required for /api/generate-description; pulled into Vercel env
# upstash_email        = "you@example.com"            # optional, enables real cross-instance rate limit
# upstash_api_key      = "..."                         # https://console.upstash.com/account/api
# upstash_redis_region = "us-east-1"                   # default us-east-1 (closer to Vercel iad1 lambdas)

# Sentry — all four optional. Leaving them empty disables Sentry entirely.
#   sentry_dsn         is the only one needed to turn on error reporting.
#   The auth_token/org/project trio is build-time only, for source map upload.
# sentry_dsn        = "https://<key>@oXXXX.ingest.sentry.io/<project-id>"
# sentry_auth_token = "sntrys_..."                     # https://<org>.sentry.io/settings/auth-tokens/
# sentry_org        = "your-org-slug"     # the URL slug, not the display name (e.g. "nick-cummings", not "Nick Cummings")
# sentry_project    = "simple-todos"

# Two-agent pipeline — GitHub Actions secret (managed as code).
#   github_token: optional; blank falls back to `export GITHUB_TOKEN=$(gh auth token)`.
#                 If set, needs fine-grained "Secrets: read/write" (or classic `repo`).
#   claude_code_oauth_token: from `claude setup-token`; Terraform pushes it to the
#                 repo as the CLAUDE_CODE_OAUTH_TOKEN Actions secret. Needs github_repo set.
# github_token            = "github_pat_..."
# claude_code_oauth_token = "sk-ant-oat01-..."
